# ==========================================
# 数据库配置
# ==========================================
# PostgreSQL 数据库连接 URL
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/postgres

# ==========================================
# JWT 认证配置
# ==========================================
# JWT 密钥 - 必须设置！生成方式：
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT 算法
JWT_ALGORITHM=HS256

# Access Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh Token 过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# 豆包实时语音配置
# ==========================================
# 豆包实时语音 App ID
VOLC_REALTIME_APP_ID=

# 豆包实时语音 Access Key
VOLC_REALTIME_ACCESS_KEY=

# 豆包实时语音 Resource ID（可选）
VOLC_REALTIME_RESOURCE_ID=volc.speech.dialog

# 豆包实时语音 App Key（可选）
VOLC_REALTIME_APP_KEY=

# 豆包实时语音 WebSocket URL（可选）
VOLC_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue

# 系统角色提示词文件路径
VOLC_REALTIME_SYSTEM_ROLE=app/prompt/interviewer-system-prompt.md

# 语音输入格式（可选）
VOLC_REALTIME_INPUT_FORMAT=pcm

# 语音输入采样率（可选）
VOLC_REALTIME_INPUT_SAMPLE_RATE=16000

# 语音输出格式（可选）
VOLC_REALTIME_OUTPUT_FORMAT=pcm

# 语音输出采样率（可选）
VOLC_REALTIME_OUTPUT_SAMPLE_RATE=24000

# 说话人（可选）
VOLC_REALTIME_SPEAKER=zh_male_yunzhou_jupiter_bigtts

# 机器人名称（可选）
VOLC_REALTIME_BOT_NAME=豆生

# 说话风格（可选）
VOLC_REALTIME_SPEAKING_STYLE=表达专业、清晰、语速适中。

# 接收超时时间（秒，可选）
VOLC_REALTIME_RECV_TIMEOUT=15

# VAD 结束平滑窗口（毫秒，可选）
VOLC_REALTIME_END_SMOOTH_WINDOW_MS=1500

# ==========================================
# 豆包 LLM 配置
# ==========================================
# 豆包 API Key
VOLC_API_KEY=your-volc-api-key

# 豆包 API Base URL（可选）
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 豆包模型名称（可选）
VOLC_MODEL=doubao-seed-1-8-251228
